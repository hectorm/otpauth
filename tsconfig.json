{
  "include": ["**/*"],
  "exclude": ["node_modules/**", "dist/**", "docs/**"],
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"],
    "target": "ESNext",
    "module": "NodeNext",
    "strict": true,
    "noUnusedLocals": true
  }
}
